# Build mango-overview from source (the "local build" route).
#   cd packaging/arch/mango-overview && makepkg -si

pkgname=mango-overview
pkgver=0.1.1
pkgrel=1
pkgdesc='Zoom-out overview with live window previews for the Mango compositor'
arch=('x86_64')
url='https://github.com/zefuros1991/mango-overview'
license=('GPL-3.0-or-later')
depends=('quickshell' 'mangowm' 'qt6-base' 'qt6-declarative' 'wayland')
makedepends=('git' 'cmake' 'ninja' 'wayland-protocols')
optdepends=('ffmpeg: blurred background from video wallpapers')
source=("$pkgname::git+$url.git#tag=v$pkgver")
b2sums=('SKIP')

build() {
	cmake -B build -S "$pkgname" -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-Wno-dev
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
