# Install the ready-made build from the GitHub release (the "prebuilt" route).
#   cd packaging/arch/mango-overview-bin && makepkg -si
# The tarball is made by scripts/make-release.sh.

pkgname=mango-overview-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Zoom-out overview with live window previews for the Mango compositor (prebuilt)'
arch=('x86_64')
url='https://github.com/zefuros1991/mango-overview'
license=('GPL-3.0-or-later')
depends=('quickshell' 'mangowm' 'qt6-base' 'qt6-declarative' 'wayland')
optdepends=('ffmpeg: blurred background from video wallpapers')
provides=('mango-overview')
conflicts=('mango-overview')
source=("$url/releases/download/v$pkgver/mango-overview-$pkgver-x86_64.tar.zst")
b2sums=('fd6a7e8900f6e5fbb8defb257bd81e0872e7a5dd2d998051e789f3c3b8525f4ceebc401d6fa198c238e630d4928bd7c0872d747f4c9b98eaa0ba473ee9f75036')

package() {
	cp -a "$srcdir/usr" "$pkgdir/"
}
